@model IEnumerable<OfficeApp.DAL.Models.HR.Attendance>
@{
    ViewData["Title"] = "Attendances";
}
<h2 class="mb-3">Attendances <small class="text-muted fs-6">(HR)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>EmployeeId</th>
        <th>CheckIn</th>
        <th>CheckOut</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.EmployeeId</td>
        <td>@item.CheckIn.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.CheckOut?.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.Notes</td>
      </tr>
}
    </tbody>
  </table>
</div>
