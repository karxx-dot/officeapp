<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - OfficeApp</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" asp-controller="Home" asp-action="Index">OfficeApp</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">HR</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Departments" asp-action="Index">Departments</a></li>
              <li><a class="dropdown-item" asp-controller="Positions" asp-action="Index">Positions</a></li>
              <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">Employees</a></li>
              <li><a class="dropdown-item" asp-controller="Attendances" asp-action="Index">Attendances</a></li>
              <li><a class="dropdown-item" asp-controller="LeaveRequests" asp-action="Index">LeaveRequests</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Inventory</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Categories</a></li>
              <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
              <li><a class="dropdown-item" asp-controller="Assets" asp-action="Index">Assets</a></li>
              <li><a class="dropdown-item" asp-controller="AssetAssignments" asp-action="Index">AssetAssignments</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Operations</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Index">Rooms</a></li>
              <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index">Reservations</a></li>
              <li><a class="dropdown-item" asp-controller="Meetings" asp-action="Index">Meetings</a></li>
              <li><a class="dropdown-item" asp-controller="MeetingAttendees" asp-action="Index">MeetingAttendees</a></li>
              <li><a class="dropdown-item" asp-controller="TaskItems" asp-action="Index">TaskItems</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Documents</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="DocumentTypes" asp-action="Index">DocumentTypes</a></li>
              <li><a class="dropdown-item" asp-controller="Documents" asp-action="Index">Documents</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <main class="container py-4">
    @RenderBody()
  </main>
  <footer class="container text-muted small pb-4">OfficeApp &middot; Arquitectura en capas (Web / BL / DAL)</footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
