@model IEnumerable<OfficeApp.DAL.Models.Operations.TaskItem>
@{
    ViewData["Title"] = "TaskItems";
}
<h2 class="mb-3">TaskItems <small class="text-muted fs-6">(Operations)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Description</th>
        <th>DueDate</th>
        <th>Priority</th>
        <th>Status</th>
        <th>AssignedToId</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Title</td>
        <td>@item.Description</td>
        <td>@item.DueDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.Priority</td>
        <td>@item.Status</td>
        <td>@item.AssignedToId</td>
      </tr>
}
    </tbody>
  </table>
</div>
