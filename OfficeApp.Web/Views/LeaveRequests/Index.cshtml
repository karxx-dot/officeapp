@model IEnumerable<OfficeApp.DAL.Models.HR.LeaveRequest>
@{
    ViewData["Title"] = "LeaveRequests";
}
<h2 class="mb-3">LeaveRequests <small class="text-muted fs-6">(HR)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>EmployeeId</th>
        <th>StartDate</th>
        <th>EndDate</th>
        <th>Reason</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.EmployeeId</td>
        <td>@item.StartDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.EndDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.Reason</td>
        <td>@item.Status</td>
      </tr>
}
    </tbody>
  </table>
</div>
