@model IEnumerable<OfficeApp.DAL.Models.Inventory.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}
<h2 class="mb-3">Suppliers <small class="text-muted fs-6">(Inventory)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Name</th>
        <th>ContactName</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.ContactName</td>
        <td>@item.Email</td>
        <td>@item.Phone</td>
        <td>@item.Address</td>
      </tr>
}
    </tbody>
  </table>
</div>
