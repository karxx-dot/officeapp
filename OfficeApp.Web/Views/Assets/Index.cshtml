@model IEnumerable<OfficeApp.DAL.Models.Inventory.Asset>
@{
    ViewData["Title"] = "Assets";
}
<h2 class="mb-3">Assets <small class="text-muted fs-6">(Inventory)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Code</th>
        <th>Name</th>
        <th>Description</th>
        <th>PurchaseDate</th>
        <th>PurchaseCost</th>
        <th>Status</th>
        <th>CategoryId</th>
        <th>SupplierId</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Code</td>
        <td>@item.Name</td>
        <td>@item.Description</td>
        <td>@item.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.PurchaseCost.ToString("N2")</td>
        <td>@item.Status</td>
        <td>@item.CategoryId</td>
        <td>@item.SupplierId</td>
      </tr>
}
    </tbody>
  </table>
</div>
