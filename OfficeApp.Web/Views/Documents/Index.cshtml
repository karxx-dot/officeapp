@model IEnumerable<OfficeApp.DAL.Models.Documents.Document>
@{
    ViewData["Title"] = "Documents";
}
<h2 class="mb-3">Documents <small class="text-muted fs-6">(Documents)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Title</th>
        <th>FilePath</th>
        <th>UploadedAt</th>
        <th>DocumentTypeId</th>
        <th>UploadedById</th>
        <th>DepartmentId</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Title</td>
        <td>@item.FilePath</td>
        <td>@item.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.DocumentTypeId</td>
        <td>@item.UploadedById</td>
        <td>@item.DepartmentId</td>
      </tr>
}
    </tbody>
  </table>
</div>
