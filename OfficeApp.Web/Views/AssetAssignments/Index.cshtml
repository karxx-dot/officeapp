@model IEnumerable<OfficeApp.DAL.Models.Inventory.AssetAssignment>
@{
    ViewData["Title"] = "AssetAssignments";
}
<h2 class="mb-3">AssetAssignments <small class="text-muted fs-6">(Inventory)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>AssetId</th>
        <th>EmployeeId</th>
        <th>AssignedDate</th>
        <th>ReturnedDate</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.AssetId</td>
        <td>@item.EmployeeId</td>
        <td>@item.AssignedDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.ReturnedDate?.ToString("yyyy-MM-dd HH:mm")</td>
      </tr>
}
    </tbody>
  </table>
</div>
