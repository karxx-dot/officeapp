@model IEnumerable<OfficeApp.DAL.Models.HR.Employee>
@{
    ViewData["Title"] = "Employees";
}
<h2 class="mb-3">Employees <small class="text-muted fs-6">(HR)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>FirstName</th>
        <th>LastName</th>
        <th>Email</th>
        <th>Phone</th>
        <th>HireDate</th>
        <th>Salary</th>
        <th>IsActive</th>
        <th>DepartmentId</th>
        <th>PositionId</th>
        <th>ManagerId</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.FirstName</td>
        <td>@item.LastName</td>
        <td>@item.Email</td>
        <td>@item.Phone</td>
        <td>@item.HireDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.Salary.ToString("N2")</td>
        <td>@(item.IsActive ? "Si" : "No")</td>
        <td>@item.DepartmentId</td>
        <td>@item.PositionId</td>
        <td>@item.ManagerId</td>
      </tr>
}
    </tbody>
  </table>
</div>
