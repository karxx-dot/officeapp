@model IEnumerable<OfficeApp.DAL.Models.Documents.DocumentType>
@{
    ViewData["Title"] = "DocumentTypes";
}
<h2 class="mb-3">DocumentTypes <small class="text-muted fs-6">(Documents)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Name</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
      </tr>
}
    </tbody>
  </table>
</div>
