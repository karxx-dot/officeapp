@model IEnumerable<OfficeApp.DAL.Models.Operations.Room>
@{
    ViewData["Title"] = "Rooms";
}
<h2 class="mb-3">Rooms <small class="text-muted fs-6">(Operations)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Capacity</th>
        <th>Location</th>
        <th>IsAvailable</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.Capacity</td>
        <td>@item.Location</td>
        <td>@(item.IsAvailable ? "Si" : "No")</td>
      </tr>
}
    </tbody>
  </table>
</div>
