@model IEnumerable<OfficeApp.DAL.Models.Operations.MeetingAttendee>
@{
    ViewData["Title"] = "MeetingAttendees";
}
<h2 class="mb-3">MeetingAttendees <small class="text-muted fs-6">(Operations)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>MeetingId</th>
        <th>EmployeeId</th>
        <th>Confirmed</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.MeetingId</td>
        <td>@item.EmployeeId</td>
        <td>@(item.Confirmed ? "Si" : "No")</td>
      </tr>
}
    </tbody>
  </table>
</div>
