@model IEnumerable<OfficeApp.DAL.Models.Operations.Reservation>
@{
    ViewData["Title"] = "Reservations";
}
<h2 class="mb-3">Reservations <small class="text-muted fs-6">(Operations)</small></h2>
<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
      <tr>
        <th>Id</th>
        <th>RoomId</th>
        <th>EmployeeId</th>
        <th>StartTime</th>
        <th>EndTime</th>
        <th>Purpose</th>
      </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
      <tr>
        <td>@item.Id</td>
        <td>@item.RoomId</td>
        <td>@item.EmployeeId</td>
        <td>@item.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@item.Purpose</td>
      </tr>
}
    </tbody>
  </table>
</div>
